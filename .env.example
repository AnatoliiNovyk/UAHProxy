# UAProxy Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="UAProxy Premium"
API_V1_STR=/api/v1

# Database (Default PostgreSQL, fallback to SQLite if postgres unavailable)
DATABASE_URL=postgresql+asyncpg://uaproxy_user:uaproxy_secret_password@localhost:5432/uaproxy
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./uaproxy.db

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0

# Security (JWT & AES Encryption)
SECRET_KEY=change-this-ultra-secret-key-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# 32 url-safe base64-encoded bytes for Fernet SSH key encryption
ENCRYPTION_KEY=W3o8OXRpYnptNmVqNmZsbThzdmVwY2NzaWk1cXZhcTg=

# Admin User Bootstrapping
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
INITIAL_ADMIN_EMAIL=admin@uaproxy.local
